    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`fct_orders`
      
    
    cluster by order_date

    
    OPTIONS()
    as (
      

with stg as (
    select * from `project-d8d88b02-3334-4b57-b24`.`STAGING`.`stg_orders`
    
),

cust as (
