    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`dim_geography`
      
    
    

    
    OPTIONS()
    as (
      

with sources as (
    select distinct
        country_code,
        state,
        city
    from `project-d8d88b02-3334-4b57-b24`.`STAGING`.`stg_customers`
