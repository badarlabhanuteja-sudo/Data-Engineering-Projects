[0m16:59:39.770133 [debug] [Thread-2 (]: On model.ecommerce_customer360.mart_churn_features: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_churn_features"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`mart_churn_features`
      
    
    

    
    OPTIONS()
    as (
      

-- =====================================================================
-- Feature store for the INTERVENTION ML churn classifier.
-- One row per customer with engineered features.
-- =====================================================================

with c360 as (
    select * from `ecommerce-customer360`.`marts`.`mart_customer_360`
    where total_orders > 0                  -- align population with baseline
),

with_derived as (
    select
        customer_id,
        customer_sk,
        is_churned                                                   as label,

        -- Demographic / signup
        case when customer_tier = 'platinum' then 4
             when customer_tier = 'gold'     then 3
             when customer_tier = 'silver'   then 2
             else 1                                          end     as tier_ordinal,
        case when is_email_subscriber = 1 then 1 else 0 end              as is_email_subscriber_int,
        case when country_code = 'IN' then 1 else 0 end              as is_country_in,
        case when signup_channel in ('google_ads', 'meta_ads', 'tiktok') then 1 else 0 end as is_paid_acquisition,

        -- Order behaviour
        total_orders,
        gross_revenue,
        avg_order_value,
        customer_tenure_days,
        days_since_last_order,
        coalesce(orders_with_promo, 0)                               as orders_with_promo,
        coalesce(total_discount_received, 0)                         as total_discount_received,
        
    case when nullif(total_orders, 0) = 0 or nullif(total_orders, 0) is null
         then null
         else SAFE_DIVIDE(CAST(coalesce(orders_with_promo, 0) AS FLOAT64), CAST(nullif(total_orders, 0) AS FLOAT64))
    end
 as promo_fraction,
        coalesce(repeat_orders_count, 0)                             as repeat_orders_count,
        
    case when nullif(total_orders, 0) = 0 or nullif(total_orders, 0) is null
         then null
         else SAFE_DIVIDE(CAST(coalesce(repeat_orders_count, 0) AS FLOAT64), CAST(nullif(total_orders, 0) AS FLOAT64))
    end
 as repeat_fraction,

        -- Web engagement
        web_sessions,
        web_page_views,
        web_product_views,
        web_cart_adds,
        web_checkouts_started,
        web_purchases_completed,
        
    case when nullif(web_product_views, 0) = 0 or nullif(web_product_views, 0) is null
         then null
         else SAFE_DIVIDE(CAST(web_cart_adds AS FLOAT64), CAST(nullif(web_product_views, 0) AS FLOAT64))
    end
 as cart_to_view_ratio,
        
    case when nullif(web_checkouts_started, 0) = 0 or nullif(web_checkouts_started, 0) is null
         then null
         else SAFE_DIVIDE(CAST(web_purchases_completed AS FLOAT64), CAST(nullif(web_checkouts_started, 0) AS FLOAT64))
    end
 as checkout_completion_rate,

        -- Email engagement
        emails_sent,
        emails_opened,
        emails_clicked,
        email_open_rate,
        email_click_rate,
        case when is_unsubscribed = 1 then 1 else 0 end                  as is_unsubscribed_int

    from c360
)

select * from with_derived
    );
  
[0m16:59:39.770133 [debug] [Thread-1 (]: On model.ecommerce_customer360.mart_clv_segments: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_clv_segments"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`mart_clv_segments`
      
    
    

    
    OPTIONS()
    as (
      

with c360 as (
    select * from `ecommerce-customer360`.`marts`.`mart_customer_360`
    where total_orders > 0
),

with_metrics as (
    select
        customer_id,
        customer_sk,
        gross_revenue                                            as historical_clv,
        total_orders,
        avg_order_value,
        customer_tenure_days,
        case when customer_tenure_days > 0
             then CAST(total_orders AS FLOAT64) / nullif(customer_tenure_days, 0)
             else null end                                       as orders_per_day,
        -- Naive forward CLV: average order value × predicted future orders
        -- (assuming retention ∝ recency)
        case
            when days_since_last_order <= 30  then avg_order_value * 12
            when days_since_last_order <= 90  then avg_order_value * 6
            when days_since_last_order <= 180 then avg_order_value * 2
            else 0
        end                                                      as projected_12m_clv
    from c360
),

bucketed as (
    select
        *,
        ntile(4) over (order by historical_clv) as clv_quartile
    from with_metrics
)

select
    *,
    case
        when clv_quartile = 4 then 'Top'
        when clv_quartile = 3 then 'High'
        when clv_quartile = 2 then 'Mid'
        else 'Low'
    end as clv_segment
from bucketed
    );
  
[0m16:59:39.776191 [debug] [Thread-4 (]: On model.ecommerce_customer360.mart_rfm_segments: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_rfm_segments"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`mart_rfm_segments`
      
    
    

    
    OPTIONS()
    as (
      

-- =====================================================================
-- BASELINE classifier for the empirical study.
-- Hughes (1996) quintile-binned RFM segmentation.
-- =====================================================================

with c360 as (
    select * from `ecommerce-customer360`.`marts`.`mart_customer_360`
    where total_orders > 0                       -- exclude never-purchasers
),

scored as (
    select
        customer_id,
        customer_sk,
        gross_revenue,
        total_orders,
        days_since_last_order,
        is_churned,

        
    
    
        ntile(5) over (order by days_since_last_order desc)
    
 as r_score,
        
    
    
        ntile(5) over (order by total_orders)
    
 as f_score,
        
    
    
        ntile(5) over (order by gross_revenue)
    
 as m_score
    from c360
)

select
    customer_id,
    customer_sk,
    r_score,
    f_score,
    m_score,
    (r_score * 100) + (f_score * 10) + m_score          as rfm_score_combined,
    
    case
        when r_score >= 4 and f_score >= 4 and m_score >= 4 then 'Champions'
        when r_score >= 3 and f_score >= 3 and m_score >= 3 then 'Loyal'
        when r_score >= 4 and f_score <= 2                       then 'Potential Loyalists'
        when r_score >= 4 and f_score = 3                        then 'New Customers'
        when r_score = 3 and f_score <= 2                        then 'Promising'
        when r_score = 2 and f_score >= 4                        then 'At Risk'
        when r_score <= 2 and f_score >= 4 and m_score >= 4 then 'Cannot Lose Them'
        when r_score <= 2 and f_score <= 2 and m_score >= 3 then 'Hibernating'
        when r_score = 1 and f_score = 1                         then 'Lost'
        else 'About to Sleep'
    end
 as rfm_segment,

    -- BASELINE churn prediction: classed as "at risk" if R is in bottom 2 quintiles
    case when r_score <= 2 then true else false end     as predicted_churn_baseline,
    -- A simple risk score: inverse of recency quintile
    (6 - r_score) / 5.0                                 as predicted_churn_score_baseline,

    is_churned                                          as actual_churn,
    gross_revenue,
    total_orders,
    days_since_last_order,
    CURRENT_TIMESTAMP()                                 as _dbt_inserted_at
from scored
    );
  
