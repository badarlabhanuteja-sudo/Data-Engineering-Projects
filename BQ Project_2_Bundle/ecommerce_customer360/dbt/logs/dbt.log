[0m15:26:34.365960 [debug] [Thread-14 ]: On model.ecommerce_customer360.mart_clv_segments: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_clv_segments"} */

  
    

    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_clv_segments`
      
    
    

    
    OPTIONS()
    as (
      

with c360 as (
    select * from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_customer_360`
    where total_orders > 0
),

with_metrics as (
    select
        customer_id,
        customer_sk,
        gross_revenue                                            as historical_clv,
        total_orders,
        avg_order_value,
        customer_tenure_days,
        case when customer_tenure_days > 0
             then CAST(total_orders AS FLOAT64) / nullif(customer_tenure_days, 0)
             else null end                                       as orders_per_day,
        -- Naive forward CLV: average order value × predicted future orders
        -- (assuming retention ∝ recency)
        case
            when days_since_last_order <= 30  then avg_order_value * 12
            when days_since_last_order <= 90  then avg_order_value * 6
            when days_since_last_order <= 180 then avg_order_value * 2
            else 0
        end                                                      as projected_12m_clv
    from c360
),

bucketed as (
    select
        *,
        ntile(4) over (order by historical_clv) as clv_quartile
    from with_metrics
)

select
    *,
    case
        when clv_quartile = 4 then 'Top'
        when clv_quartile = 3 then 'High'
        when clv_quartile = 2 then 'Mid'
        else 'Low'
    end as clv_segment
from bucketed
    );
  
[0m15:26:34.605834 [debug] [Thread-11 ]: BigQuery adapter: https://console.cloud.google.com/bigquery?project=project-d8d88b02-3334-4b57-b24&j=bq:US:dfd71d90-6481-43f5-a96b-21dc2233283e&page=queryresults
