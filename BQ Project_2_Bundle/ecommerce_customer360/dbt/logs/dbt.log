[0m15:59:04.958653 [debug] [Thread-2 (]: On model.ecommerce_customer360.fct_orders: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.fct_orders"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`fct_orders`
      
    
    cluster by order_date

    
    OPTIONS()
    as (
      

with stg as (
    select * from `ecommerce-customer360`.`staging`.`stg_orders`
    
),

cust as (
    select customer_sk, customer_business_key, valid_from, valid_to
    from `ecommerce-customer360`.`marts`.`dim_customer_scd2`
)

select
    s.order_id,
    -- Surrogate key resolution: pick the customer SK valid at order time
    c.customer_sk,
    s.customer_id                          as customer_business_key,
    s.order_date,
    to_hex(md5(cast(coalesce(cast(s.order_date as string), '_dbt_utils_surrogate_key_null_') as string))) as date_sk,
    s.order_timestamp,
    s.order_status,
    s.payment_method,
    s.shipping_method,
    s.promo_code,
    s.discount_amount,
    s.shipping_amount,
    s.tax_amount,
    s.total_amount,
    s.gross_merchandise_value,
    s.currency,
    s.is_first_order,
    s.is_completed,
    s._loaded_at,
    current_timestamp() as _dbt_inserted_at
from stg s
left join cust c
       on s.customer_id = c.customer_business_key
      and cast(s.order_date as timestamp) >= c.valid_from
      and cast(s.order_date as timestamp) <  coalesce(c.valid_to, cast('9999-12-31' as timestamp))
    );
  
[0m15:59:04.990584 [debug] [Thread-1 (]: Writing runtime sql for node "model.ecommerce_customer360.dim_geography"
[0m15:59:04.990584 [debug] [Thread-1 (]: On model.ecommerce_customer360.dim_geography: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.dim_geography"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`dim_geography`
      
    
    

    
    OPTIONS()
    as (
      

with sources as (
    select distinct
        country_code,
        state,
        city
    from `ecommerce-customer360`.`staging`.`stg_customers`
)

select
    to_hex(md5(cast(coalesce(cast(country_code as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(state as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(city as string), '_dbt_utils_surrogate_key_null_') as string))) as geography_sk,
    country_code,
    state,
    city,
    case country_code
        when 'IN' then 'India'
        when 'GB' then 'United Kingdom'
        when 'US' then 'United States'
        when 'CA' then 'Canada'
        when 'AU' then 'Australia'
        else country_code
    end                                  as country_name,
    case
        when country_code = 'IN' then 'APAC'
        when country_code in ('GB') then 'EMEA'
        when country_code in ('US', 'CA') then 'NAM'
        when country_code = 'AU' then 'APAC'
        else 'OTHER'
    end                                  as region
from sources
    );
  
