    create or replace table `ecommerce-customer360`.`marts`.`fct_order_items`
      
    
    

    
    OPTIONS()
    as (
      

with items as (
    select * from `ecommerce-customer360`.`staging`.`stg_order_items`
    
),

orders as (
    select order_id, customer_sk, customer_business_key, order_date, date_sk
    from `ecommerce-customer360`.`marts`.`fct_orders`
),

prods as (
    select product_sk, product_business_key, valid_from, valid_to
    from `ecommerce-customer360`.`marts`.`dim_product_scd2`
)

select
    i.order_item_id,
    i.order_id,
    o.customer_sk,
    o.customer_business_key,
    o.order_date,
    o.date_sk,
    p.product_sk,
    i.product_id                          as product_business_key,
    i.quantity,
    i.unit_price,
    i.line_total,
    i.gross_line_total,
    i.discount_pct,
    i._loaded_at,
    current_timestamp()                   as _dbt_inserted_at
from items i
left join orders o on i.order_id = o.order_id
left join prods  p on i.product_id = p.product_business_key
                  and o.order_date >= p.valid_from
                  and o.order_date <  p.valid_to
    );
  
