    AS NUMERIC)                                                     as gross_merchandise_value,
    case when order_status = 'delivered' then true else false end    as is_completed,
    created_at,
    updated_at
from `project-d8d88b02-3334-4b57-b24`.`RAW`.`raw_orders`;


