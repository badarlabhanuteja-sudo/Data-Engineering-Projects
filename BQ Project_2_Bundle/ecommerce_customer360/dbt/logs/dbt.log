[0m15:06:00.330294 [debug] [Thread-3 (]: On model.ecommerce_customer360.stg_web_events: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.stg_web_events"} */


  create or replace view `ecommerce-customer360`.`staging`.`stg_web_events`
  OPTIONS(
      description=""""""
    )
  as 

select
    event_id,
    customer_id,
    session_id,
    event_timestamp,
    event_type,
    -- Pull common fields out of the JSON payload
    JSON_VALUE(payload, '$.device')                                 as device,
    CAST(JSON_VALUE(payload, '$.product_id') AS INT64)              as product_id,
    JSON_VALUE(payload, '$.query')                                  as search_query,
    CAST(JSON_VALUE(payload, '$.cart_value') AS NUMERIC)            as cart_value,
    CAST(JSON_VALUE(payload, '$.cart_size') AS INT64)               as cart_size,
    -- Keep the raw payload for ad-hoc analysis
    payload                                                         as payload_json,
    user_agent,
    ip_address,
    referrer,
    case
        when referrer like '%google%'       then 'google'
        when referrer like '%facebook%'     then 'facebook'
        when referrer like '%instagram%'    then 'instagram'
        when referrer = 'direct'            then 'direct'
        when referrer is null               then 'unknown'
        else 'other'
    end                                                             as referrer_channel,
    _loaded_at
from `ecommerce-customer360`.`RAW`.`raw_web_events`;


