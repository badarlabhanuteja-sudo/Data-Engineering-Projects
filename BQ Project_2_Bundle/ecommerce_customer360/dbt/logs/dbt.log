[0m15:21:12.416735 [debug] [Thread-8 (]: On model.ecommerce_customer360.mart_churn_features: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_churn_features"} */

  
    

    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_churn_features`
      
    
    

    
    OPTIONS()
    as (
      

-- =====================================================================
-- Feature store for the INTERVENTION ML churn classifier.
-- One row per customer with engineered features.
-- =====================================================================

with c360 as (
    select * from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_customer_360`
    where total_orders > 0                  -- align population with baseline
),

with_derived as (
    select
        customer_id,
        customer_sk,
        is_churned                                                   as label,

        -- Demographic / signup
        case when customer_tier = 'platinum' then 4
             when customer_tier = 'gold'     then 3
             when customer_tier = 'silver'   then 2
             else 1                                          end     as tier_ordinal,
        case when is_email_subscriber = 1 then 1 else 0 end              as is_email_subscriber_int,
        case when country_code = 'IN' then 1 else 0 end              as is_country_in,
        case when signup_channel in ('google_ads', 'meta_ads', 'tiktok') then 1 else 0 end as is_paid_acquisition,

        -- Order behaviour
        total_orders,
        gross_revenue,
        avg_order_value,
        customer_tenure_days,
        days_since_last_order,
        coalesce(orders_with_promo, 0)                               as orders_with_promo,
        coalesce(total_discount_received, 0)                         as total_discount_received,
        
    case when nullif(total_orders, 0) = 0 or nullif(total_orders, 0) is null
         then null
         else SAFE_DIVIDE(CAST(coalesce(orders_with_promo, 0) AS FLOAT64), CAST(nullif(total_orders, 0) AS FLOAT64))
    end
 as promo_fraction,
        coalesce(repeat_orders_count, 0)                             as repeat_orders_count,
        
    case when nullif(total_orders, 0) = 0 or nullif(total_orders, 0) is null
         then null
         else SAFE_DIVIDE(CAST(coalesce(repeat_orders_count, 0) AS FLOAT64), CAST(nullif(total_orders, 0) AS FLOAT64))
    end
 as repeat_fraction,

        -- Web engagement
        web_sessions,
        web_page_views,
        web_product_views,
        web_cart_adds,
        web_checkouts_started,
        web_purchases_completed,
        
    case when nullif(web_product_views, 0) = 0 or nullif(web_product_views, 0) is null
         then null
         else SAFE_DIVIDE(CAST(web_cart_adds AS FLOAT64), CAST(nullif(web_product_views, 0) AS FLOAT64))
    end
 as cart_to_view_ratio,
        
    case when nullif(web_checkouts_started, 0) = 0 or nullif(web_checkouts_started, 0) is null
         then null
         else SAFE_DIVIDE(CAST(web_purchases_completed AS FLOAT64), CAST(nullif(web_checkouts_started, 0) AS FLOAT64))
    end
 as checkout_completion_rate,

        -- Email engagement
        emails_sent,
        emails_opened,
        emails_clicked,
        email_open_rate,
        email_click_rate,
        case when is_unsubscribed = 1 then 1 else 0 end                  as is_unsubscribed_int

    from c360
)

select * from with_derived
    );
  
[0m15:21:12.416735 [debug] [Thread-9 (]: On model.ecommerce_customer360.mart_cohort_retention: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_cohort_retention"} */

  
    

    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_cohort_retention`
      
    
    

    
    OPTIONS()
    as (
      

with first_orders as (
    select
        customer_id,
        DATE_TRUNC(min(order_date), MONTH) as cohort_month
    from `project-d8d88b02-3334-4b57-b24`.`STAGING`.`stg_orders`
    where is_completed
    group by 1
),

orders_with_cohort as (
    select
        o.customer_id,
        f.cohort_month,
        DATE_TRUNC(o.order_date, MONTH)                                        as order_month,
        DATE_DIFF(DATE_TRUNC(o.order_date, MONTH), f.cohort_month, MONTH)      as months_since_signup,
        o.gross_merchandise_value
    from `project-d8d88b02-3334-4b57-b24`.`STAGING`.`stg_orders` o
    join first_orders f using (customer_id)
    where o.is_completed
),

cohort_sizes as (
    select cohort_month, count(*) as cohort_size from first_orders group by 1
)

select
    o.cohort_month,
    o.months_since_signup,
    cs.cohort_size,
    count(distinct o.customer_id)                                                          as active_customers,
    CAST(count(distinct o.customer_id) AS FLOAT64) / nullif(cs.cohort_size, 0)            as retention_rate,
    sum(o.gross_merchandise_value)                                                         as revenue
from orders_with_cohort o
join cohort_sizes cs using (cohort_month)
group by 1, 2, 3
order by 1, 2
    );
  
