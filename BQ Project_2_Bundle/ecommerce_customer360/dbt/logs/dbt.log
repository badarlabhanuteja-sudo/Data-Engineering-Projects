[0m15:37:08.012738 [debug] [Thread-4 (]: On model.ecommerce_customer360.dim_geography: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.dim_geography"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`dim_geography`
      
    
    

    
    OPTIONS(
      description=""""""
    )
    as (
      

with sources as (
    select distinct
        country_code,
        state,
        city
    from `ecommerce-customer360`.`staging`.`stg_customers`
)

select
    to_hex(md5(cast(coalesce(cast(country_code as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(state as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(city as string), '_dbt_utils_surrogate_key_null_') as string))) as geography_sk,
    country_code,
    state,
    city,
    case country_code
        when 'IN' then 'India'
        when 'GB' then 'United Kingdom'
        when 'US' then 'United States'
        when 'CA' then 'Canada'
        when 'AU' then 'Australia'
        else country_code
    end                                  as country_name,
    case
        when country_code = 'IN' then 'APAC'
        when country_code in ('GB') then 'EMEA'
        when country_code in ('US', 'CA') then 'NAM'
        when country_code = 'AU' then 'APAC'
        else 'OTHER'
    end                                  as region
from sources
    );
  
[0m15:37:08.595516 [debug] [Thread-3 (]: Writing runtime sql for node "model.ecommerce_customer360.mart_cohort_retention"
[0m15:37:08.598548 [debug] [Thread-3 (]: On model.ecommerce_customer360.mart_cohort_retention: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_cohort_retention"} */

  
    

    create or replace table `ecommerce-customer360`.`marts`.`mart_cohort_retention`
      
    
    

    
    OPTIONS(
      description=""""""
    )
    as (
      

with first_orders as (
    select
        customer_id,
        DATE_TRUNC(min(order_date), MONTH) as cohort_month
    from `ecommerce-customer360`.`staging`.`stg_orders`
    where is_completed
    group by 1
),

orders_with_cohort as (
    select
        o.customer_id,
        f.cohort_month,
        DATE_TRUNC(o.order_date, MONTH)                                        as order_month,
        DATE_DIFF(DATE_TRUNC(o.order_date, MONTH), f.cohort_month, MONTH)      as months_since_signup,
        o.gross_merchandise_value
    from `ecommerce-customer360`.`staging`.`stg_orders` o
    join first_orders f using (customer_id)
    where o.is_completed
),

cohort_sizes as (
    select cohort_month, count(*) as cohort_size from first_orders group by 1
)

select
    o.cohort_month,
    o.months_since_signup,
    cs.cohort_size,
    count(distinct o.customer_id)                                                          as active_customers,
    CAST(count(distinct o.customer_id) AS FLOAT64) / nullif(cs.cohort_size, 0)            as retention_rate,
    sum(o.gross_merchandise_value)                                                         as revenue
from orders_with_cohort o
join cohort_sizes cs using (cohort_month)
group by 1, 2, 3
order by 1, 2
    );
  
