        when 'US' then 'United States'
        when 'CA' then 'Canada'
        when 'AU' then 'Australia'
        else country_code
    end                                  as country_name,
    case
        when country_code = 'IN' then 'APAC'
        when country_code in ('GB') then 'EMEA'
        when country_code in ('US', 'CA') then 'NAM'
        when country_code = 'AU' then 'APAC'
        else 'OTHER'
    end                                  as region
from sources
    );
  
