    create or replace table `ecommerce-customer360`.`marts`.`dim_product_scd2`
      
    
    

    
    OPTIONS(
      description="""Type 2 slowly-changing product dimension with category hierarchy"""
    )
    as (
      

with  __dbt__cte__int_product_hierarchy as (


with products  as (select * from `ecommerce-customer360`.`staging`.`stg_products`),
     categories as (select * from `ecommerce-customer360`.`staging`.`stg_categories`)

select
    p.product_id,
    p.product_name,
    p.brand,
    p.supplier,
    p.unit_price,
    p.cost,
    p.margin,
    p.margin_pct,
    p.is_active,
    p.launch_date,
    -- Leaf category
    c.category_id                       as category_id,
    c.category_name                     as category_name,
    -- Parent category (if any)
    parent.category_id                  as parent_category_id,
    parent.category_name                as parent_category_name,
    coalesce(parent.department, c.department) as department
from products p
left join categories c       on p.category_id = c.category_id
left join categories parent  on c.parent_category_id = parent.category_id
), snapshot_data as (
    select * from `ecommerce-customer360`.`SNAPSHOTS`.`products_snapshot`
),

cat as (
    select * from __dbt__cte__int_product_hierarchy
),

with_keys as (
    select
        to_hex(md5(cast(coalesce(cast(s.product_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(s.dbt_valid_from as string), '_dbt_utils_surrogate_key_null_') as string))) as product_sk,
        s.product_id                                  as product_business_key,
        s.product_name,
        s.brand,
        s.supplier,
        s.unit_price,
        s.cost,
        s.unit_price - s.cost                         as margin,
        case when s.unit_price > 0
             then (s.unit_price - s.cost) / s.unit_price end as margin_pct,
        s.is_active,
        s.launch_date,
        c.category_id,
        c.category_name,
        c.parent_category_id,
        c.parent_category_name,
        c.department,
        s.dbt_valid_from                              as valid_from,
        coalesce(s.dbt_valid_to, '9999-12-31')        as valid_to,
        case when s.dbt_valid_to is null then true else false end as is_current
    from snapshot_data s
    left join cat c on s.product_id = c.product_id
)

select * from with_keys
    );
  
