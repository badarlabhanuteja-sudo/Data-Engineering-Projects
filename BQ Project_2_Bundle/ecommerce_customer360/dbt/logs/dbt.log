    OPTIONS(
      expiration_timestamp=TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 12 hour)
    )
    as (
      

with items as (
    select * from `project-d8d88b02-3334-4b57-b24`.`STAGING`.`stg_order_items`
    
        where _loaded_at >= (select coalesce(max(_loaded_at), TIMESTAMP('1900-01-01')) from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`fct_order_items`)
    
),

orders as (
    select order_id, customer_sk, customer_business_key, order_date, date_sk
    from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`fct_orders`
),

prods as (
    select product_sk, product_business_key, valid_from, valid_to
    from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`dim_product_scd2`
)

select
    i.order_item_id,
    i.order_id,
    o.customer_sk,
    o.customer_business_key,
    o.order_date,
    o.date_sk,
    p.product_sk,
    i.product_id                          as product_business_key,
    i.quantity,
    i.unit_price,
    i.line_total,
    i.gross_line_total,
    i.discount_pct,
    current_timestamp()                   as _dbt_inserted_at
from items i
left join orders o on i.order_id = o.order_id
left join prods  p on i.product_id = p.product_business_key
                  and o.order_date >= p.valid_from
                  and o.order_date <  p.valid_to
    );
  
