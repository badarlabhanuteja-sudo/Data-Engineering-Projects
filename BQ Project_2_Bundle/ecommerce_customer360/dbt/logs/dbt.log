    create or replace table `ecommerce-customer360`.`marts`.`dim_customer_scd2`
      
    
    

    
    OPTIONS(
      description="""Type 2 slowly-changing customer dimension"""
    )
    as (
      

with snapshot_data as (
    select * from `ecommerce-customer360`.`snapshots`.`customers_snapshot`
),

with_keys as (
    select
        to_hex(md5(cast(coalesce(cast(customer_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dbt_valid_from as string), '_dbt_utils_surrogate_key_null_') as string)))
                                              as customer_sk,
        customer_id                           as customer_business_key,
        email,
        first_name,
        last_name,
        gender,
        country_code,
        state,
        city,
        postal_code,
        signup_channel,
        is_email_subscriber,
        customer_tier,
        dbt_valid_from                        as valid_from,
        coalesce(dbt_valid_to, '9999-12-31')  as valid_to,
        case when dbt_valid_to is null then true else false end as is_current
    from snapshot_data
)

select * from with_keys
    );
  
