[0m16:02:13.882837 [debug] [Thread-12 ]: On model.ecommerce_customer360.mart_rfm_segments: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_rfm_segments"} */

  
    

    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_rfm_segments`
      
    
    

    
    OPTIONS()
    as (
      

-- =====================================================================
-- BASELINE classifier for the empirical study.
-- Hughes (1996) quintile-binned RFM segmentation.
-- =====================================================================

with c360 as (
    select * from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_customer_360`
    where total_orders > 0                       -- exclude never-purchasers
),

scored as (
    select
        customer_id,
        customer_sk,
        gross_revenue,
        total_orders,
        days_since_last_order,
        is_churned,

        
    
    
        ntile(5) over (order by days_since_last_order desc)
    
 as r_score,
        
    
    
        ntile(5) over (order by total_orders)
    
 as f_score,
        
    
    
        ntile(5) over (order by gross_revenue)
    
 as m_score
    from c360
)

select
    customer_id,
    customer_sk,
    r_score,
    f_score,
    m_score,
    (r_score * 100) + (f_score * 10) + m_score          as rfm_score_combined,
    
    case
        when r_score >= 4 and f_score >= 4 and m_score >= 4 then 'Champions'
        when r_score >= 3 and f_score >= 3 and m_score >= 3 then 'Loyal'
        when r_score >= 4 and f_score <= 2                       then 'Potential Loyalists'
        when r_score >= 4 and f_score = 3                        then 'New Customers'
        when r_score = 3 and f_score <= 2                        then 'Promising'
        when r_score = 2 and f_score >= 4                        then 'At Risk'
        when r_score <= 2 and f_score >= 4 and m_score >= 4 then 'Cannot Lose Them'
        when r_score <= 2 and f_score <= 2 and m_score >= 3 then 'Hibernating'
        when r_score = 1 and f_score = 1                         then 'Lost'
        else 'About to Sleep'
    end
 as rfm_segment,

    -- BASELINE churn prediction: classed as "at risk" if R is in bottom 2 quintiles
    case when r_score <= 2 then true else false end     as predicted_churn_baseline,
    -- A simple risk score: inverse of recency quintile
    (6 - r_score) / 5.0                                 as predicted_churn_score_baseline,

    is_churned                                          as actual_churn,
    gross_revenue,
    total_orders,
    days_since_last_order,
    CURRENT_TIMESTAMP()                                 as _dbt_inserted_at
from scored
    );
  
[0m16:02:13.952774 [debug] [Thread-11 ]: Writing runtime sql for node "model.ecommerce_customer360.mart_product_affinity"
[0m16:02:13.952774 [debug] [Thread-11 ]: On model.ecommerce_customer360.mart_product_affinity: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "ecommerce_customer360", "target_name": "dev", "node_id": "model.ecommerce_customer360.mart_product_affinity"} */

  
    

    create or replace table `project-d8d88b02-3334-4b57-b24`.`MARTS`.`mart_product_affinity`
      
    
    

    
    OPTIONS()
    as (
      

with items as (
    select order_id, product_business_key as product_id
    from `project-d8d88b02-3334-4b57-b24`.`MARTS`.`fct_order_items`
),

-- Pairs of products that co-occur in the same order
pairs as (
    select
        a.product_id as anchor_product_id,
        b.product_id as paired_product_id,
        count(distinct a.order_id) as co_occurrences
    from items a
    join items b on a.order_id = b.order_id
                 and a.product_id < b.product_id
    group by 1, 2
    having count(distinct a.order_id) >= 5         -- noise filter
),

product_orders as (
    select product_id, count(distinct order_id) as orders_with_product
    from items
    group by 1
),

total_orders as (
    select count(distinct order_id) as total_orders from items
)

select
    p.anchor_product_id,
    p.paired_product_id,
    p.co_occurrences,
    a.orders_with_product as anchor_orders,
    b.orders_with_product as paired_orders,
    t.total_orders        as total_orders,
    -- Support, confidence, lift
    CAST(p.co_occurrences AS FLOAT64) / nullif(t.total_orders, 0)                          as support,
    CAST(p.co_occurrences AS FLOAT64) / nullif(a.orders_with_product, 0)                   as confidence,
    (CAST(p.co_occurrences AS FLOAT64) / nullif(a.orders_with_product, 0))
        / nullif(CAST(b.orders_with_product AS FLOAT64) / nullif(t.total_orders, 0), 0)    as lift
from pairs p
join product_orders a on p.anchor_product_id = a.product_id
join product_orders b on p.paired_product_id = b.product_id
cross join total_orders t
order by lift desc nulls last
    );
  
