    SUM(channel_revenue)                           as attributed_revenue,
    
    SAFE_DIVIDE(CAST(SUM(channel_revenue) AS FLOAT64), CAST((SELECT SUM(channel_revenue) FROM normalized) AS FLOAT64))
 as attributed_share
from normalized
group by channel
order by attributed_revenue desc
    );
  
