    sum(duration_min) as active_minutes_24h,
    max(dropoff_timestamp) as last_trip_at

from `project-d8d88b02-3334-4b57-b24`.`staging`.`stg_trips`

where is_completed
  and dropoff_timestamp >= TIMESTAMP_SUB(
        CURRENT_TIMESTAMP(),
        INTERVAL 24 HOUR
      )

group by driver_id


)

select
driver_id,
trips_24h,
km_24h,
revenue_24h,
